rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
        || (exists(/databases/$(database)/documents/settings/bootstrap)
          && get(/databases/$(database)/documents/settings/bootstrap).data.adminId == request.auth.uid)
      );
    }

    function hasRole(roles) {
      return signedIn() && (
        ('admin' in roles && isAdmin())
        || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in roles)
      );
    }

    function isStaff() {
      return isAdmin() || hasRole(['secretary', 'pedagogical_lead', 'trainer']);
    }

    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    match /settings/bootstrap {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.adminId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isStaff() || (signedIn() && request.auth.uid == userId);
      // Account creation: admin can create any account; secretary can only create trainees; bootstrap can create first admin
      allow create: if isAdmin()
        || (hasRole(['secretary']) && request.resource.data.role == 'trainee')
        || (signedIn() && request.auth.uid == userId
            && request.resource.data.role == 'admin'
            && !exists(/databases/$(database)/documents/settings/bootstrap));
      // Account update:
      // - Admin has full update rights
      // - Secretary can only update trainee accounts without changing role
      // - Users can only update their own non-sensitive profile info (never role or active state)
      allow update: if isAdmin()
        || (hasRole(['secretary']) && resource.data.role == 'trainee'
            && request.resource.data.role == 'trainee')
        || (signedIn() && request.auth.uid == userId
            && request.resource.data.role == resource.data.role
            && request.resource.data.active == resource.data.active
            && onlyChanges(['fullName', 'phone', 'specialty', 'room', 'lastAuditId']));
      // Account deletion: admin can delete any account; secretary can only delete trainees
      allow delete: if isAdmin()
        || (hasRole(['secretary']) && resource.data.role == 'trainee');
    }

    match /formations/{formationId} {
      allow read: if isStaff();
      allow create, delete: if isAdmin() || hasRole(['pedagogical_lead']);
      allow update: if isAdmin() || hasRole(['pedagogical_lead'])
        || (hasRole(['secretary']) && onlyChanges(['traineeIds', 'lastAuditId']));
    }

    match /courses/{courseId} {
      allow read: if isStaff();
      allow create, delete: if isAdmin() || hasRole(['pedagogical_lead']);
      allow update: if isAdmin() || hasRole(['pedagogical_lead'])
        || (hasRole(['secretary']) && onlyChanges(['traineeIds', 'lastAuditId']));
    }

    match /subjects/{subjectId} {
      allow read: if isStaff();
      allow create, update, delete: if isAdmin() || hasRole(['pedagogical_lead']);
    }

    match /timetableSlots/{slotId} {
      allow read: if isStaff();
      allow create, update, delete: if isAdmin() || hasRole(['pedagogical_lead']);
    }

    match /holidays/{holidayId} {
      allow read: if isStaff();
      allow write: if (isAdmin() || hasRole(['secretary']))
        && (request.resource == null || (
          request.resource.data.type in ['holiday', 'vacation']
          && request.resource.data.startDate <= request.resource.data.endDate));
    }

    match /attendances/{attendanceId} {
      allow read: if isStaff();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    match /sessionOverrides/{overrideId} {
      allow read: if isStaff();
      allow write: if isAdmin() || hasRole(['pedagogical_lead', 'secretary']);
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      // Audit logs are strictly append-only and author-verified
      allow create: if isStaff()
        && request.resource.data.actorId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
